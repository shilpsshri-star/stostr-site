{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/daily",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/daily/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/miradesigns#calendar-2027",
      "permanent": false
    },
    {
      "source": "/mira",
      "destination": "/miradesigns",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/img/sample-:f",
      "destination": "/community-calendar/img/sample-:f"
    },
    {
      "source": "/img/founder.jpg",
      "destination": "/community-calendar/img/founder.jpg"
    },
    {
      "source": "/img/tip-:f",
      "destination": "/business-calendar/img/tip-:f"
    },
    {
      "source": "/img/tipcover-:f",
      "destination": "/business-calendar/img/tipcover-:f"
    },
    {
      "source": "/img/festival-:f",
      "destination": "/business-calendar/img/festival-:f"
    },
    {
      "source": "/img/page-:f",
      "destination": "/indian-festival-calendar/img/page-:f"
    },
    {
      "source": "/img/a-:f",
      "destination": "/business-calendar/img/a-:f"
    }
  ]
}